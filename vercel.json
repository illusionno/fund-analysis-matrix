{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/chat.ts": {
      "maxDuration": 120
    },
    "api/review.ts": {
      "maxDuration": 60
    },
    "api/marketAnalysis.ts": {
      "maxDuration": 60
    },
    "api/market.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/)(?!.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}