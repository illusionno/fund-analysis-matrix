# 复盘 AI：OpenAI 兼容接口（chat/completions）
# 本地开发复制为 .env.local；Vercel 在项目 Environment Variables 中配置同名变量。

OPENAI_API_KEY=

# 可选：留空则默认 https://api.openai.com/v1
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 基础环境变量，兼容 OpenAI 格式接口地址
OPENAI_API_BASE=
OPENAI_MODEL=
# 文本复盘优先使用文本模型；视觉/推理大模型更容易触发限流。
# 其他常见模型名以控制台为准：qwen-max 等。
# 若请求报错或与 response_format(json_object) 不兼容，可换模型或查阅百炼「兼容 OpenAI」文档。
